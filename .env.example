# Supabase — create a free project at supabase.com, then Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the web app's server-side routes and by the workers/
# pipeline (GitHub Actions) to write data, bypassing RLS. Never expose this
# to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Same value as NEXT_PUBLIC_SUPABASE_URL, kept separate since worker scripts
# don't have Next.js's NEXT_PUBLIC_ inlining.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Optional paid connectors — omit any of these and the connector
# self-disables (skips itself, doesn't error the pipeline).
WEB3_CAREER_API_TOKEN=
TWITTERAPI_IO_KEY=

# Optional paid contact-enrichment (backfills a named contact for leads that
# have a website but no contact yet). They run cheapest-first and stop at the
# first hit: Hunter, then Prospeo, then PDL, then Apollo (which spends a
# reveal credit per lead). Each self-disables if its key is unset.
HUNTER_API_KEY=
PROSPEO_API_KEY=
PDL_API_KEY=
APOLLO_API_KEY=

# Optional AI providers — none are required for core CRM functionality.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
